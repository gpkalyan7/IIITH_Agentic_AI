# Copy to .env and edit. .env is gitignored and must never be committed.
# Every value here has a working default, so the project runs with no .env
# at all -- it simply falls back to deterministic baselines with no model.

# ollama | gemini | openai | offline
LLM_PROVIDER=ollama

# Developed against llama3.1:8b on local Ollama.
LLM_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Seconds between model calls. Free tiers are often ~15 requests/minute, so
# 4 seconds keeps us comfortably under without special-casing. Local models
# default to 0.
LLM_REQUEST_INTERVAL=0

# Retries on HTTP 429 and 5xx, with exponential backoff.
LLM_MAX_RETRIES=4
LLM_TIMEOUT=120

# Cache model responses on disk by prompt hash, so re-running a capability is
# free and produces the same output for a marker as it did here.
LLM_CACHE=1
LLM_TEMPERATURE=0.1
